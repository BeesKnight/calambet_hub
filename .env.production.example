DJANGO_DEBUG=False

# Existing reverse-proxy network. Keep calambet_default on the original host;
# use zavozik_ingress on trans-platform.com.
PROXY_NETWORK=calambet_default

HUB_BIND_IP=127.0.0.1
HUB_PORT=8080

LEARNING_LOG_SECRET_KEY=replace-with-a-long-random-secret
LEARNING_LOG_BIND_IP=127.0.0.1
LEARNING_LOG_PORT=8081
LEARNING_LOG_ALLOWED_HOSTS=log.trans-platform.com,localhost,127.0.0.1
LEARNING_LOG_CSRF_TRUSTED_ORIGINS=https://log.trans-platform.com

TASK_MANAGER_SECRET_KEY=replace-with-a-long-random-secret
TASK_MANAGER_BIND_IP=127.0.0.1
TASK_MANAGER_PORT=8082
TASK_MANAGER_ALLOWED_HOSTS=tasks.trans-platform.com,localhost,127.0.0.1
TASK_MANAGER_CSRF_TRUSTED_ORIGINS=https://tasks.trans-platform.com

BLOG_SECRET_KEY=replace-with-a-long-random-secret
BLOG_BIND_IP=127.0.0.1
BLOG_PORT=8083
BLOG_ALLOWED_HOSTS=blog.trans-platform.com,localhost,127.0.0.1
BLOG_CSRF_TRUSTED_ORIGINS=https://blog.trans-platform.com
